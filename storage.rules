rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images: path products/{storeId}/...
    match /products/{storeId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Store logo / banner: stores/{id}/...
    match /stores/{path=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Homepage banners
    match /banners/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
